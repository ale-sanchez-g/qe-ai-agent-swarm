# Environment variables for Docker deployment
# Copy this file to .env and fill in your actual values

# Required: Anthropic API Key for Claude LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: LaunchDarkly SDK Key for AI configuration management
LAUNCHDARKLY_SDK_KEY=your_launchdarkly_sdk_key_here

# Optional: Dynatrace integration for observability
DYNATRACE_ENDPOINT=https://your-tenant.live.dynatrace.com/api/v2/otlp
DYNATRACE_API_TOKEN=your_dynatrace_api_token_here

# Container configuration
COMPOSE_PROJECT_NAME=planner-chat

# Optional: Custom port mapping (default is 8000:8000)
# HOST_PORT=8000

# Optional: Log level for debugging
# LOG_LEVEL=debug
