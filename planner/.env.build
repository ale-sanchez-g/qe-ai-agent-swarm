# Build configuration for Docker images
# This file controls build behavior

# Set to "true" to always build without cache
FORCE_NO_CACHE=false

# Set to "true" to always pull latest base images
FORCE_PULL=true

# Build tag strategy: timestamp, git, or manual
# timestamp: Uses date and time
# git: Uses git commit hash
# manual: Uses BUILD_TAG environment variable
BUILD_TAG_STRATEGY=timestamp

# Manual build tag (used when BUILD_TAG_STRATEGY=manual)
BUILD_TAG=latest

# Registry for pushing images (optional)
DOCKER_REGISTRY=

# Additional build arguments
DOCKER_BUILDKIT=1