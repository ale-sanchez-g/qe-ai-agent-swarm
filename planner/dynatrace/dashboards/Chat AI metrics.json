            "type": "data",
            "query": "fetch logs\n| filter data.data.type == \"message\"\n| sort timestamp desc\n| fieldsAdd \n    time = formatTimestamp(timestamp, format:\"MMM dd, HH:mm:ss\"),\n    role_icon = if(data.data.role == \"user\", \"👤\", \n                else: if(data.data.role == \"assistant\", \"🤖\", else: \"⚙️\"))      \n| fields \n    time,\n    role = data.data.role,\n    model = data.data.model,\n    request_id = data.data._request_id,\n    content = data.data.content,\n    stop_reason = coalesce(data.data.stop_reason, \"N/A\"),\n    event_type = event.type\n| limit 50\n",
            "visualization": "recordView",
            "visualizationSettings": {
                "autoSelectVisualization": false,
                "thresholds": []
