        "19": {
            "title": "SLI: Token Error Rate (Target: 0%)",
            "type": "data",
            "query": "fetch logs\n| filter namespace == \"mcp_agent.mcp.mcp_aggregator.ChatAgent\" and message == \"Requesting tool call\"\n| summarize total_calls = count(), token_errors = countIf(matchesPhrase(data.data.error_message, \"token\"))\n| fieldsAdd token_error_rate_pct = round((token_errors / total_calls) * 100, decimals: 2)\n| fieldsAdd sli_status = if(token_error_rate_pct == 0, \"✅ IDEAL\", else: if(token_error_rate_pct <= 0.5, \"⚠️ WARN\", else: \"❌ CRITICAL\"))",
            "visualization": "singleValue",
            "visualizationSettings": {
                "singleValue": {
                    "label": "Token Errors %",
                    "isIconVisible": true
                },
                "autoSelectVisualization": false,
