        "21": {
            "title": "RUM Correlation: Request Sessions by Conversation Quality",
            "type": "data",
            "query": "fetch logs\n| filter data.data.type == \"message\" and isNotNull(data.data._request_id)\n| summarize total_messages = count(), errors = countIf(data.data.stop_reason == \"error\"), avg_input_tokens = round(avg(toLong(data.data.usage.input_tokens)), decimals: 0), avg_output_tokens = round(avg(toLong(data.data.usage.output_tokens)), decimals: 0), by:{data.data._request_id}\n| fieldsAdd quality_score = round(((total_messages - errors) / total_messages) * 100, decimals: 1)\n| sort quality_score desc\n| limit 20",
