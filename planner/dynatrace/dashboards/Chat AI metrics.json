            "query": "fetch logs\n| filter data.data.type == \"message\"\n| summarize total_messages = count(), error_messages = countIf(data.data.stop_reason == \"error\")\n| fieldsAdd error_rate_pct = round((error_messages / total_messages) * 100, decimals: 2)\n| fieldsAdd budget_consumed_pct = error_rate_pct, budget_remaining_pct = round(100 - error_rate_pct, decimals: 1)",
            "visualization": "table",
