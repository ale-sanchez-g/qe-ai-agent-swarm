            "query": "fetch logs\n| filter data.data.type == \"message\" and isNotNull(data.data.model) and isNotNull(trace_id)\n| summarize \n    {inputTokensPerTrace   = sum(coalesce(toLong(data.data.usage.input_tokens), 0)),\n    outputTokensPerTrace  = sum(coalesce(toLong(data.data.usage.output_tokens), 0))}\n  , by: { trace_id }\n| fieldsAdd\n    costPerTraceUSD = (inputTokensPerTrace  / 1000000.0) * 0.80\n                  + (outputTokensPerTrace / 1000000.0) * 4.00\n| summarize\n    {totalInputTokens  = sum(inputTokensPerTrace),\n    totalOutputTokens = sum(outputTokensPerTrace),\n    totalCostUSD      = round(sum(costPerTraceUSD), decimals: 2)}, by: { trace_id}\n| lookup [fetch logs | filter isNotNull(data.data.model) and isNotNull(data.data.chat_turn)], sourceField:trace_id, lookupField:trace_id\n\n| fieldsKeep trace_id, totalInputTokens, totalOutputTokens, totalCostUSD, lookup.data.data.chat_turn, lookup.data.data.model\n| sort lookup.data.data.chat_turn desc",
