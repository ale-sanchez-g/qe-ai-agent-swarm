        "13": {
            "title": "Tool Connections",
            "type": "data",
            "query": "fetch logs\n| filter namespace == \"mcp_agent.mcp.mcp_connection_manager\"\n| filter matchesPhrase(message, \"Up and running\") or matchesPhrase(message, \"Requesting shutdown\") or matchesPhrase(message, \"Error\")\n| fieldsAdd server_name = substring(message, from: 0, to: indexOf(message, \":\"))\n| fieldsAdd event = if(matchesPhrase(message, \"Up and running\"), \"connected\",\n                  else: if(matchesPhrase(message, \"Requesting shutdown\"), \"shutdown\",\n                  else: if(matchesPhrase(message, \"Error\"), \"error\", else: \"other\")))\n| summarize count = count(), by:{server_name, event}\n| sort server_name asc, event asc",
            "visualization": "table",
            "visualizationSettings": {
                "table": {
                    "columnOrder": [
                        "[\"server_name\"]",
                        "[\"event\"]",
                        "[\"count\"]"
                    ]
                },
                "autoSelectVisualization": true,
                "thresholds": []
            },
            "querySettings": {
                "maxResultRecords": 1000,
                "defaultScanLimitGbytes": 500,
                "maxResultMegaBytes": 1,
                "defaultSamplingRatio": 10,
                "enableSampling": false
            },
            "davis": {
                "enabled": false,
                "davisVisualization": {
                    "isAvailable": true
                }
            }
        },
        "14": {
            "title": "Session Trail",
            "type": "data",
            "query": "fetch logs\n| filter matchesPhrase(message, \"[DEBUG] Session \") and matchesPhrase(message, \"Message #\")\n| fieldsAdd session_start = indexOf(message, \"Session \") + 8\n| fieldsAdd session_end = indexOf(message, \": Message #\")\n| fieldsAdd session_id = substring(message, from: session_start, to: session_end)\n| fieldsAdd count_start = indexOf(message, \"Message #\") + 9\n| fieldsAdd count_end = indexOf(message, \" received\")\n| fieldsAdd message_count = toLong(substring(message, from: count_start, to: count_end))\n| summarize last_message = max(timestamp), max_message_count = max(message_count), by:{session_id}\n| sort last_message desc\n| limit 100",
            "visualization": "table",
            "visualizationSettings": {
                "table": {
                    "columnOrder": [
                        "[\"session_id\"]",
                        "[\"max_message_count\"]",
                        "[\"last_message\"]"
                    ]
                },
                "autoSelectVisualization": true,
                "thresholds": []
            },
            "querySettings": {
                "maxResultRecords": 1000,
                "defaultScanLimitGbytes": 500,
                "maxResultMegaBytes": 1,
                "defaultSamplingRatio": 10,
                "enableSampling": false
            },
            "davis": {
                "enabled": false,
                "davisVisualization": {
                    "isAvailable": true
                }
            }
        },
