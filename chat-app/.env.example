# Environment variables for the AI Chat Application

# LaunchDarkly Configuration
LAUNCHDARKLY_SDK_KEY=your-launchdarkly-sdk-key-here
LAUNCHDARKLY_AI_CONFIG_KEY=chat-ai-config

# AWS Configuration
AWS_PROFILE=qbe-split-poc
AWS_REGION=us-east-1

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-change-this-in-production
FLASK_ENV=development