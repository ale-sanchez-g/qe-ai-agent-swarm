{
	"servers": {
		"io.github.dynatrace-oss/Dynatrace-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"--registry",
				"https://registry.npmjs.org",
				"@dynatrace-oss/dynatrace-mcp-server@1.1.0"
			],
			"env": {
				"DT_ENVIRONMENT": "${input:DT_ENVIRONMENT}",
				"DT_API_TOKEN": "${input:DT_API_TOKEN}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.0"
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		}
	},
	"inputs": [
		{
			"id": "DT_ENVIRONMENT",
			"type": "promptString",
			"description": "The URL of your Dynatrace environment (e.g. 'https://abc12345.apps.dynatrace.com')",
			"password": false
		},
		{
			"id": "DT_API_TOKEN",
			"type": "promptString",
			"description": "Your Dynatrace API token (with grail:read scope for RUM data)",
			"password": true
		}
	]
}